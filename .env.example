# Vercel: configure separately for Preview and Production. Never reuse live payments in Preview.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never use a NEXT_PUBLIC prefix for privileged keys.
SUPABASE_SERVICE_ROLE_KEY=
# Keep disabled until sandbox tests, reviews and operating procedures are complete.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# At least 32 random bytes, URL safe. Keep out of logs and rotate deliberately.
MPESA_CALLBACK_SECRET=
CRON_SECRET=
# Private verification documents. Keep this key backed up separately from the database.
DOCUMENT_ENCRYPTION_KEY=
# Your approved malware-scanning endpoint. POST binary bytes, return {"clean":true} only after scanning.
DOCUMENT_SCAN_URL=
DOCUMENT_SCAN_TOKEN=
